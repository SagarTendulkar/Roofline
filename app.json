{
    "expo": {
        "name": "RoofLine",
        "slug": "real-estate-r_native",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/roofline.png",
        "scheme": "realestaternative",
        "userInterfaceStyle": "automatic",
        "ios": {
            "icon": "./assets/expo.icon"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "Allow Kribb to access your location to tag property coordinates."
                }
            ],
            "@clerk/expo",
            "expo-secure-store"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
